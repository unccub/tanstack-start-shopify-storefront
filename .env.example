# Copy to .env and fill in. With no .env at all the storefront talks to
# https://mock.shop/api, Shopify's free mock Storefront API.

# Your store's domain, for example your-store.myshopify.com.
# Leave empty to use mock.shop.
PUBLIC_STORE_DOMAIN=

# Optional. A private Storefront API token. Server only: it is never sent to
# the browser. Needed for the store's menus, metafields and metaobjects.
PRIVATE_STOREFRONT_API_TOKEN=

# Set to true on demo or staging deployments to add noindex to every page.
PUBLIC_NOINDEX=

# Optional. The public address of the site, used for canonical URLs and the
# sitemap. Netlify's own URL is used when this is empty.
PUBLIC_SITE_URL=

# Optional, for debugging. Logs each Storefront API query's cost on the server.
# Tokenless access allows a cost of up to 1,000 per query.
STOREFRONT_LOG_COST=
