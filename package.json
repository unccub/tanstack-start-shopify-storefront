{
  "name": "tanstack-start-shopify-storefront",
  "version": "0.1.0",
  "description": "A custom storefront starter on Shopify's Storefront API, built with TanStack Start.",
  "license": "MIT",
  "author": "UNCCUB TECHNOLOGIES LTD (https://unccub.com)",
  "homepage": "https://starter.unccub.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unccub/tanstack-start-shopify-storefront.git"
  },
  "bugs": "https://github.com/unccub/tanstack-start-shopify-storefront/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "codegen": "gql.tada generate-schema https://shopify.dev/storefront-graphql-direct-proxy/2026-10 --output ./schema.graphql && gql.tada generate-output",
    "codegen:check": "gql.tada check",
    "start": "node scripts/serve.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:e2e": "playwright test",
    "test": "playwright test",
    "social-preview": "node scripts/social-preview.mjs"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.4",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "gql.tada": "^1.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
